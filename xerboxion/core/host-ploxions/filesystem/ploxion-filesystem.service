[Unit]
Description=ploxion filesystem (migré hors-docker → host, dans le xerboxion-core)
After=network.target

[Service]
Type=simple
User=debian
WorkingDirectory=/home/debian/xerboxion-rt/host-ploxions/filesystem
Environment=FS_HOST=127.0.0.1
Environment=FS_PORT=3010
ExecStart=/usr/bin/python3 -u /home/debian/xerboxion-rt/host-ploxions/filesystem/fs_service.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
