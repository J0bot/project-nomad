[Unit]
Description=ploxion tsoin (migré hors-docker → host, dans le xerboxion-core)
After=network.target
[Service]
Type=simple
User=debian
WorkingDirectory=/home/debian/xerboxion-rt/host-ploxions/tsoin
Environment=TSOIN_HOST=127.0.0.1
Environment=TSOIN_PORT=3011
ExecStart=/usr/bin/python3 -u /home/debian/xerboxion-rt/host-ploxions/tsoin/tsoin_service.py
Restart=always
RestartSec=3
[Install]
WantedBy=multi-user.target
